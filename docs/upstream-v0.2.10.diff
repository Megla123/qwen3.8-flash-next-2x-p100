+            float ps = 0.f;
+#pragma unroll
+            for (int i = 0; i < 8; ++i) {
+                pr[i] = s[i] == -INFINITY ? 0.f : __expf(s[i] - mn);
+                ps += pr[i];
+            }
+            ps += __shfl_xor_sync(0xffffffffu, ps, 4);
+            ps += __shfl_xor_sync(0xffffffffu, ps, 8);
