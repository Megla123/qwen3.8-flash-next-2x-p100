+        w[0] = P100_U16(x->qs, 8 * ib); w[1] = P100_U16(x->qs, 8 * ib + 2); w[2] = P100_U16(x->qs, 8 * ib + 4); w[3] = P100_U16(x->qs, 8 * ib + 6);
