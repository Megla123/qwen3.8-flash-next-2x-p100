+// logit_bias=<id>:<bias>,... as serve/logit_bias.py writes it (each token once): the list for Sampling::bias. The same text as
+// the request before gives the same list (Klepet sends one of 65,929 tokens with every message), parsed once
+std::shared_ptr<const fnx::Bias> parse_bias(const std::string& cmd, const std::string& v, int vocab) {
+    static std::mutex mu;
+    static std::string last_text;
+    static std::shared_ptr<const fnx::Bias> last;
+    std::lock_guard<std::mutex> lock(mu);
+    if (last && v == last_text) return last;
+    std::vector<std::pair<int, float>> out;
+    for (const std::string& e : split_commas(v)) {
+        const size_t c = e.find(':');
+        long long id = -1;
+        if (c == std::string::npos || !fnx::parse_whole(e.substr(0, c).c_str(), id) || id < 0 || id >= vocab)
+            throw std::runtime_error(cmd + ": logit_bias entry '" + e.substr(0, 40) + "' is not <token id>:<bias> within the vocabulary");
+        const float b = field_float(cmd, "logit_bias", e.substr(c + 1));
+        if (b < -100.f || b > 100.f) throw std::runtime_error(cmd + ": logit_bias " + e.substr(0, 40) + ": a bias is from -100 to 100");
+        out.emplace_back((int) id, b);
+    }
+    try {
+        last = fnx::make_bias(std::move(out));
+    } catch (const std::runtime_error& ex) {
+        throw std::runtime_error(cmd + ": " + ex.what());
+    }
+    last_text = v;
+    return last;
+}
