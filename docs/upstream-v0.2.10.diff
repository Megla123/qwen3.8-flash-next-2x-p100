+// this thread on the CPU the card hangs from (each P100 of the DL380 has its own)
+void pin_to_card(int dev) {
+    char id[64] = {};
+    if (cudaDeviceGetPCIBusId(id, sizeof id, dev) != cudaSuccess) {
+        cudaGetLastError();
+        return;
+    }
+    std::string s(id);
+    for (char& ch : s) ch = (char) std::tolower((unsigned char) ch);
+    if (s.size() > 12) s = s.substr(s.size() - 12);
+    std::ifstream f("/sys/bus/pci/devices/" + s + "/local_cpulist");
+    std::string list;
+    if (!std::getline(f, list)) return;
+    cpu_set_t set;
+    CPU_ZERO(&set);
+    int a = -1, b = -1;
+    const char* p = list.c_str();
+    while (*p) {
+        char* end = nullptr;
+        a = (int) std::strtol(p, &end, 10);
+        if (end == p) break;
+        b = a;
+        p = end;
+        if (*p == '-') {
+            b = (int) std::strtol(p + 1, &end, 10);
+            p = end;
+        }
+        for (int i = a; i <= b && i < CPU_SETSIZE; ++i) CPU_SET(i, &set);
+        if (*p == ',') ++p;
+    }
+    if (CPU_COUNT(&set) > 0) sched_setaffinity(0, sizeof set, &set);
+}
