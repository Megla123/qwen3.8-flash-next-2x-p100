+std::shared_ptr<const Bias> make_bias(std::vector<std::pair<int, float>> v) {
+    std::sort(v.begin(), v.end());
+    uint64_t h = 1469598103934665603ull;   // FNV-1a over the (token, bias bits) pairs
+    for (size_t i = 0; i < v.size(); ++i) {
+        if (i && v[i].first == v[i - 1].first) throw std::runtime_error("logit_bias: token " + std::to_string(v[i].first) + " twice");
+        uint32_t bits;
+        std::memcpy(&bits, &v[i].second, 4);
+        for (const uint32_t w : {(uint32_t) v[i].first, bits})
+            for (int k = 0; k < 4; ++k) h = (h ^ ((w >> (8 * k)) & 255u)) * 1099511628211ull;
+    }
+    auto b = std::make_shared<Bias>();
+    b->v = std::move(v);
+    b->key = h ? h : 1;   // 0 is a card's empty slot
+    return b;
+}
