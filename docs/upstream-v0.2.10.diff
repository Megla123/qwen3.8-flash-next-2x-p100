+                    h[i] = __hfma2(qy, *reinterpret_cast<const half2*>(&k.y), h[i]);
+                    h[i] = __hfma2(qz, *reinterpret_cast<const half2*>(&k.z), h[i]);
+                    h[i] = __hfma2(qw, *reinterpret_cast<const half2*>(&k.w), h[i]);
+                }
